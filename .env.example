# Plantilla de variables de entorno de citas-api.
# Copiar a .env y reemplazar los CHANGE_ME. NUNCA versionar el .env real ni secretos.

# --- Base de datos MySQL 8.4 -----------------------------------------------------------
# Desde otro contenedor (docker compose): DB_HOST=mysql y DB_PORT=3306
# Desde el host Windows:                  DB_HOST=localhost y DB_PORT=3308
DB_HOST=localhost
DB_PORT=3306
DB_NAME=citas_fcv_training
DB_USER=citas_app
DB_PASSWORD=CHANGE_ME

# --- JWT (los usara el slice de autenticacion) -----------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# D36: el refresh token viaja en la cookie HttpOnly `fcv_refresh` (Path=/api/auth, SameSite=Strict).
# Secure=true funciona en http://localhost; false solo para un host HTTP que no sea localhost.
REFRESH_COOKIE_SECURE=true

# --- Recuperacion de contrasena (HU-006/HU-007, D27) -------------------------------------
# Minutos de vigencia del token de un solo uso.
PASSWORD_RESET_MINUTES=30
# SOLO laboratorio: true anade `devToken` a la respuesta de un email existente (no hay envio de
# correo). Fuera del laboratorio, false: con true la respuesta revela que el email existe.
PASSWORD_RESET_EXPOSE_TOKEN=false

# --- Primer ADMIN (decision D5) ---------------------------------------------------------
# Se crea al arrancar solo si no existe ningun ADMIN. Dejar vacio para no crear ninguno.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- CORS / frontend -------------------------------------------------------------------
# Origen exacto del frontend citas-web. Separar con coma si hay varios. Nunca usar *.
# Origen exacto del frontend para CORS. Este workspace sirve el servidor de desarrollo en
# el 5174 (citas-web/vite.config.ts lo fija con strictPort). Si aqui se deja otro puerto, el
# navegador recibe un fallo de CORS que en la interfaz parece "no pudimos contactar al servidor".
FRONTEND_ORIGIN=http://localhost:5174

# --- Servidor (opcional) ---------------------------------------------------------------
# Puerto en el que escucha la API. Es el de DENTRO del contenedor: docker-compose lo publica
# en el 8081 del host (API_PORT en el .env de la raiz).
SERVER_PORT=8080
