{
  "name": "jhonNuñez-WF-002-status-notifications",
  "description": "Webhook desde Spring: notifica por Gmail los cambios de estado de cita (aprobada, rechazada, cancelada, reprogramación), con validación, idempotencia y registro.",
  "settings": { "executionOrder": "v1", "availableInMCP": true, "binaryMode": "separate" },
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "citas/jhon-nunez/status-change", "authentication": "headerAuth", "responseMode": "responseNode", "options": {} },
