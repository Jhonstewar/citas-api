    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "id", "value": "iqNu0V8hyF7mXAau" },
        "matchType": "allConditions",
        "filters": { "conditions": [ { "keyName": "eventId", "keyValue": "={{ $json.eventId }}" }, { "keyName": "result", "keyValue": "SENT" } ] },
        "limit": 1
      },
      "id": "83cd83e9-abf3-4745-b369-7096d3f97c12",
      "name": "Buscar evento ya procesado",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [672, 96],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [ { "leftValue": "={{ $json.id }}", "operator": { "type": "number", "operation": "exists", "singleValue": true }, "rightValue": "" } ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6b8ef130-fad1-4566-a891-bec58eafed63",
      "name": "¿Ya procesado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [896, 96]
    },
    {
      "parameters": {
        "respondWith": "json",
