      "name": "Evento de cambio de estado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 192]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n-id", "name": "eventId", "value": "={{ $json.body?.eventId ?? $json.eventId ?? \"\" }}", "type": "string" },
            { "id": "n-type", "name": "eventType", "value": "={{ $json.body?.eventType ?? $json.eventType ?? \"\" }}", "type": "string" },
            { "id": "n-appt", "name": "appointmentId", "value": "={{ Number($json.body?.appointmentId ?? $json.appointmentId) }}", "type": "number" },
            { "id": "n-mail", "name": "patientEmail", "value": "={{ $json.body?.patient?.email ?? $json.patient?.email ?? \"\" }}", "type": "string" },
            { "id": "n-name", "name": "patientName", "value": "={{ $json.body?.patient?.fullName ?? $json.body?.patient?.firstName ?? $json.patient?.fullName ?? $json.patient?.firstName ?? \"\" }}", "type": "string" },
            { "id": "n-date", "name": "date", "value": "={{ $json.body?.appointment?.date ?? $json.appointment?.date ?? \"\" }}", "type": "string" },
            { "id": "n-start", "name": "startTime", "value": "={{ $json.body?.appointment?.startTime ?? $json.appointment?.startTime ?? \"\" }}", "type": "string" },
            { "id": "n-end", "name": "endTime", "value": "={{ $json.body?.appointment?.endTime ?? $json.appointment?.endTime ?? \"\" }}", "type": "string" },
            { "id": "n-site", "name": "siteName", "value": "={{ $json.body?.appointment?.site?.name ?? $json.appointment?.site?.name ?? \"\" }}", "type": "string" },
            { "id": "n-prof", "name": "professional", "value": "={{ $json.body?.appointment?.professional ?? $json.appointment?.professional ?? \"\" }}", "type": "string" },
            { "id": "n-spec", "name": "specialty", "value": "={{ $json.body?.appointment?.specialty ?? $json.appointment?.specialty ?? \"\" }}", "type": "string" },
            { "id": "n-reason", "name": "reason", "value": "={{ String($json.body?.reason ?? $json.reason ?? \"\").slice(0, 300) }}", "type": "string" },
            { "id": "n-test", "name": "testMode", "value": true, "type": "boolean" },
            { "id": "n-rcpt", "name": "testRecipient", "value": "CONFIGURAR-CORREO-DE-PRUEBA@invalid.test", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "d6637919-6c8a-47c1-a317-5b6f5a78829e",
      "name": "Normalizar evento",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [224, 192]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [
            { "leftValue": "={{ $json.eventType }}", "operator": { "type": "string", "operation": "regex" }, "rightValue": "^(APPOINTMENT_APPROVED|APPOINTMENT_REJECTED|APPOINTMENT_CANCELLED|RESCHEDULE_APPROVED|RESCHEDULE_REJECTED)$" },
            { "leftValue": "={{ $json.eventId }}", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }, "rightValue": "" },
            { "leftValue": "={{ $json.patientEmail }}", "operator": { "type": "string", "operation": "regex" }, "rightValue": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
            { "leftValue": "={{ $json.appointmentId }}", "operator": { "type": "number", "operation": "gt" }, "rightValue": 0 }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c93552d3-8a75-4dfa-86a8-4876043c1c2e",
      "name": "¿Evento válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
