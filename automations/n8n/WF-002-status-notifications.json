        "options": { "responseCode": 200 }
      },
      "id": "73905ed5-bd43-4793-a859-ba8d74aee0e4",
      "name": "Responder 200 duplicado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1120, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c-rcpt", "name": "recipient", "value": "={{ $(\"Normalizar evento\").item.json.testMode ? $(\"Normalizar evento\").item.json.testRecipient : $(\"Normalizar evento\").item.json.patientEmail }}", "type": "string" },
            { "id": "c-mask", "name": "recipientMasked", "value": "={{ String($(\"Normalizar evento\").item.json.testMode ? $(\"Normalizar evento\").item.json.testRecipient : $(\"Normalizar evento\").item.json.patientEmail).replace(/^(.).*(@.*)$/, \"$1***$2\") }}", "type": "string" },
            { "id": "c-subj", "name": "subject", "value": "={{ ({ APPOINTMENT_APPROVED: \"Tu cita fue aprobada\", APPOINTMENT_REJECTED: \"Tu solicitud de cita fue rechazada\", APPOINTMENT_CANCELLED: \"Tu cita fue cancelada\", RESCHEDULE_APPROVED: \"Tu reprogramación fue aprobada\", RESCHEDULE_REJECTED: \"Tu reprogramación fue rechazada\" })[$(\"Normalizar evento\").item.json.eventType] }}", "type": "string" },
            { "id": "c-body", "name": "body", "value": "=Hola {{ $(\"Normalizar evento\").item.json.patientName }},\n\n{{ ({ APPOINTMENT_APPROVED: \"Tu solicitud de cita fue aprobada.\", APPOINTMENT_REJECTED: \"Tu solicitud de cita fue rechazada.\", APPOINTMENT_CANCELLED: \"Tu cita fue cancelada.\", RESCHEDULE_APPROVED: \"Tu reprogramación fue aprobada; la cita quedó en la nueva franja.\", RESCHEDULE_REJECTED: \"Tu reprogramación fue rechazada; tu cita original se mantiene.\" })[$(\"Normalizar evento\").item.json.eventType] }}\n\nDetalle de la cita:\n- Especialidad: {{ $(\"Normalizar evento\").item.json.specialty }}\n- Fecha: {{ $(\"Normalizar evento\").item.json.date }}\n- Hora: {{ $(\"Normalizar evento\").item.json.startTime }} a {{ $(\"Normalizar evento\").item.json.endTime }}\n- Sede: {{ $(\"Normalizar evento\").item.json.siteName }}\n- Profesional: {{ $(\"Normalizar evento\").item.json.professional }}{{ $(\"Normalizar evento\").item.json.reason ? \"\\nMotivo: \" + $(\"Normalizar evento\").item.json.reason : \"\" }}\n\nMensaje automático del laboratorio FCV (datos ficticios).", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "1f71156f-20ba-4ed3-a47b-5bf01a76dfa3",
      "name": "Componer mensaje",
      "type": "n8n-nodes-base.set",
