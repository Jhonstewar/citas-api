  "connections": {
    "Cada hora": { "main": [ [ { "node": "Configuración", "type": "main", "index": 0 } ] ] },
    "Configuración": { "main": [ [ { "node": "Consultar citas próximas", "type": "main", "index": 0 } ] ] },
    "Descartar ya enviados": { "main": [ [ { "node": "Preparar recordatorio", "type": "main", "index": 0 } ] ] },
    "Preparar recordatorio": { "main": [ [ { "node": "Enviar recordatorio", "type": "main", "index": 0 } ] ] },
    "Enviar recordatorio": { "main": [ [ { "node": "Registrar enviado", "type": "main", "index": 0 } ], [ { "node": "Registrar fallo", "type": "main", "index": 0 } ] ] },
    "Disparo a demanda": { "main": [ [ { "node": "Configuración", "type": "main", "index": 0 } ] ] },
    "Consultar citas próximas": { "main": [ [ { "node": "Solo APPROVED", "type": "main", "index": 0 } ], [ { "node": "Registrar error API", "type": "main", "index": 0 } ] ] },
